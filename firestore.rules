rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Catch-all default rule to ensure general access
    match /{document=**} {
      allow read, write: if true;
    }

    // Explicit collection configurations for Food Review Bangladesh database
    match /categories/{id} {
      allow read, write: if true;
    }

    match /banners/{id} {
      allow read, write: if true;
    }

    match /reviews/{id} {
      allow read, write: if true;
    }

    match /offers/{id} {
      allow read, write: if true;
    }

    match /moderators/{id} {
      allow read, write: if true;
    }

    match /settings/{id} {
      allow read, write: if true;
    }
  }
}
